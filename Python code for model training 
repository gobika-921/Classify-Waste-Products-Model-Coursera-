      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "8N24ztWdyvMb"
      },
      "outputs": [],
      "source": [
        "for layer in base_model.layers:\n",
        "    layer.trainable = False"
      ]
    },
